---
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/inter/wght.css';
import '../estilos/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  /** Landing: arranca en el prólogo (oculta el logotipo fijo hasta que el script lo decida). */
  prologo?: boolean;
}

const { titulo, descripcion, prologo = false } = Astro.props;
const tituloCompleto = titulo === 'Boxrus' ? titulo : `${titulo} · Boxrus`;
const canonica = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es" data-prologo={prologo ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {canonica && <link rel="canonical" href={canonica} />}
    <!-- Proyecto de práctica: no indexar un gimnasio inexistente (docs/09) -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#16181b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
