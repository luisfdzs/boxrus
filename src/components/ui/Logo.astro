---
// Logotipo (texto BOXRUS) arriba y centrado: vuelve al inicio. En el recorrido
// lo anima la página (evento `ir-al-inicio`, cancelado por quien lo atiende);
// en el resto, va a `/` y empieza en el prólogo.
// `fijo` (landing): píldora fija arriba y centrada. Sin él (páginas): en línea, dentro de la cabecera.
// En el prólogo y el cierre de la landing se oculta (`html[data-prologo]`, `html[data-cierre]`): ahí ya aparece el titular BOXRUS.
interface Props {
  fijo?: boolean;
}
const { fijo = false } = Astro.props;
---

<a class:list={['logo', { fijo }]} href="/" aria-label="Boxrus, volver al inicio">BOXRUS</a>

<script>
  const logo = document.querySelector<HTMLAnchorElement>('.logo')!;
  logo.addEventListener('click', (e) => {
    e.preventDefault();
    if (!dispatchEvent(new Event('ir-al-inicio', { cancelable: true }))) return;
    // Que el navegador no restaure la posición: la recarga empieza en el prólogo.
    history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);
    location.assign('/');
  });
</script>

<style>
  .logo {
    display: inline-block;
    padding: 0.35rem 1.1rem 0.3rem;
    font-family: var(--fuente-titulares);
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--color-luz);
    text-decoration: none;
    background: rgb(13 14 16 / 0.82);
    backdrop-filter: blur(8px);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-bottom: 2px solid var(--color-acento);
    border-radius: 999px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
  }

  .logo.fijo {
    position: fixed;
    top: calc(0.9rem + env(safe-area-inset-top));
    left: 50%;
    z-index: 3;
    transform: translateX(-50%);
    transition:
      opacity 0.4s ease,
      visibility 0.4s;
  }

  :global(html[data-prologo]) .logo.fijo,
  :global(html[data-cierre]) .logo.fijo {
    opacity: 0;
    visibility: hidden;
  }

</style>
