---
// Pie común: dirección, contacto, apertura, enlaces, aviso de contenido ficticio y
// atribuciones. Todo sale de `src/content/ubicacion/` y de `paradas.ts`; nada duplicado.
import { cargarGimnasio, telefonoHref } from '../../lib/contenido';
import { textoApertura } from '../../lib/etiquetas';
import { SECCIONES } from '../../lib/secciones';

interface Props {
  /** `claro`: sobre el fundido a blanco del cierre de la landing. */
  variante?: 'oscuro' | 'claro';
  /** En el cierre de la landing (que ya tiene sus accesos) se omiten las secciones y, en móvil, la apertura. */
  compacto?: boolean;
  /** Solo marca, secciones y aviso: para `/ubicacion`, que ya muestra dirección, contacto y apertura. */
  reducido?: boolean;
}
const { variante = 'oscuro', compacto = false, reducido = false } = Astro.props;
const gimnasio = await cargarGimnasio();
const { calle, codigoPostal, localidad } = gimnasio.direccion;
---

<footer class:list={['pie', variante, { compacto }]}>
  <div class="columnas">
    <div>
      <p class="marca">{gimnasio.nombre}</p>
      {
        !reducido && (
          <address>
            {calle}<br />
            {codigoPostal} {localidad}
          </address>
        )
      }
    </div>
    {
      !reducido && (
        <>
          <div>
            <p class="titulo">Contacto</p>
            <p>
              <a href={telefonoHref(gimnasio.telefono)}>{gimnasio.telefono}</a>
              <br />
              <a href={`mailto:${gimnasio.email}`}>{gimnasio.email}</a>
            </p>
          </div>
          <div class="apertura">
            <p class="titulo">Abrimos</p>
            <p>
              {gimnasio.apertura.map((a, i) => (
                <>
                  {i > 0 && <br />}
                  {textoApertura(a)}
                </>
              ))}
            </p>
          </div>
        </>
      )
    }
    {
      !compacto && (
        <nav aria-label="Secciones (pie)">
          <p class="titulo">Secciones</p>
          <ul>
            {SECCIONES.map((s) => <li><a href={s.href}>{s.nombre}</a></li>)}
          </ul>
        </nav>
      )
    }
  </div>
  <p class="legal">
    Contenido ficticio: Boxrus es un gimnasio inventado y esta web es un proyecto de práctica. Tipografías Anton e Inter
    (SIL OFL). Mapas: © colaboradores de OpenStreetMap.
  </p>
</footer>

<style>
  .pie {
    --texto: var(--color-luz);
    --tenue: #b4babf;
    padding: 1.5rem 0;
    background: rgb(13 14 16 / 0.92);
    border-top: 1px solid rgb(255 255 255 / 0.08);
    color: var(--texto);
    font-size: 0.9rem;
  }

  .pie.claro {
    --texto: var(--color-acero);
    --tenue: #4a4f54;
    background: transparent;
    border-top: 1px solid rgb(22 24 27 / 0.15);
  }

  .columnas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 2rem;
    width: min(72rem, 100%);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  p {
    margin: 0;
  }

  .marca {
    font-family: var(--fuente-titulares);
    font-size: 1.4rem;
    letter-spacing: 0.08em;
  }

  .titulo {
    margin-bottom: 0.25rem;
    color: var(--tenue);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  address {
    font-style: normal;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: 0.2rem;
    color: var(--texto);
    text-underline-offset: 3px;
  }

  .legal {
    width: min(72rem, 100%);
    margin: 1rem auto 0;
    padding-inline: clamp(1rem, 4vw, 2rem);
    color: var(--tenue);
    font-size: 0.8rem;
  }

  .pie.claro :global(:focus-visible) {
    outline-color: var(--color-acero);
    box-shadow: 0 0 0 5px #fff;
  }

  @media (max-width: 640px) {
    .columnas {
      grid-template-columns: 1fr 1fr;
    }

    .compacto .apertura {
      display: none;
    }

    .compacto {
      padding-block: 0.75rem;
      font-size: 0.85rem;
    }

    .compacto .legal {
      margin-top: 0.5rem;
      font-size: 0.72rem;
    }
  }
</style>
