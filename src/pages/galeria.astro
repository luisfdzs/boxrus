---
import { Image, getImage } from 'astro:assets';
import Pagina from '../layouts/Pagina.astro';
import { cargarGaleria } from '../lib/contenido';

const imagenes = await cargarGaleria();
// Versión grande para el visor (la rejilla usa miniaturas responsive).
const grandes = await Promise.all(imagenes.map(({ data }) => getImage({ src: data.imagen, width: 1600, format: 'webp' })));
---

<Pagina
  titulo="Galería"
  descripcion="Galería de Boxrus: imágenes de la nave, la jaula, los sacos y el tatami."
  entradilla="Mira lo que pasa aquí dentro."
  imagen="01-jaula-picado"
  actual="/galeria"
>
  <div class="pagina">

    {
      imagenes.length === 0 ? (
        <p>Estamos montando la galería. Vuelve pronto.</p>
      ) : (
        <ul class="rejilla">
          {imagenes.map(({ data }, i) => (
            <li>
              <button
                type="button"
                class="miniatura"
                data-grande={grandes[i].src}
                data-ancho={grandes[i].attributes.width}
                data-alto={grandes[i].attributes.height}
                data-pie={data.pie ?? ''}
                data-alt={data.alt}
                aria-haspopup="dialog"
              >
                <span class="solo-lectores">Ampliar imagen: </span>
                <Image
                  src={data.imagen}
                  alt={data.alt}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 640px) 50vw, (max-width: 1100px) 33vw, 340px"
                  loading={i < 3 ? 'eager' : 'lazy'}
                                    format="webp"
                />
                {data.pie && <span class="pie-miniatura">{data.pie}</span>}
              </button>
            </li>
          ))}
        </ul>
      )
    }

    <dialog id="visor" aria-label="Visor de imágenes">
      <div class="visor-marco">
        <button type="button" class="cerrar" data-accion="cerrar" aria-label="Cerrar visor">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"></path></svg>
        </button>
        <figure>
          <img id="visor-imagen" alt="" />
          <figcaption id="visor-pie" aria-live="polite"></figcaption>
        </figure>
        <button type="button" class="nav anterior" data-accion="anterior" aria-label="Imagen anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"></path></svg>
        </button>
        <button type="button" class="nav siguiente" data-accion="siguiente" aria-label="Imagen siguiente">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"></path></svg>
        </button>
        <p class="contador" id="visor-contador"></p>
      </div>
    </dialog>
  </div>
</Pagina>

<script>
  const visor = document.querySelector<HTMLDialogElement>('#visor');
  const miniaturas = [...document.querySelectorAll<HTMLButtonElement>('.miniatura')];

  if (visor && miniaturas.length > 0) {
    const imagen = visor.querySelector<HTMLImageElement>('#visor-imagen')!;
    const pie = visor.querySelector<HTMLElement>('#visor-pie')!;
    const contador = visor.querySelector<HTMLElement>('#visor-contador')!;
    let actual = 0;

    const mostrar = (indice: number) => {
      actual = (indice + miniaturas.length) % miniaturas.length;
      const { grande, alt, pie: texto, ancho, alto } = miniaturas[actual].dataset;
      imagen.src = grande!;
      imagen.alt = alt ?? '';
      if (ancho && alto) {
        imagen.width = Number(ancho);
        imagen.height = Number(alto);
      }
      pie.textContent = texto ?? '';
      contador.textContent = `${actual + 1} de ${miniaturas.length}`;
    };

    miniaturas.forEach((boton, i) =>
      boton.addEventListener('click', () => {
        mostrar(i);
        visor.showModal();
      }),
    );

    visor.addEventListener('click', (e) => {
      const objetivo = (e.target as HTMLElement).closest<HTMLElement>('[data-accion]');
      if (objetivo?.dataset.accion === 'cerrar') visor.close();
      else if (objetivo?.dataset.accion === 'anterior') mostrar(actual - 1);
      else if (objetivo?.dataset.accion === 'siguiente') mostrar(actual + 1);
      // Clic en el fondo (fuera del marco): cerrar.
      else if (e.target === visor) visor.close();
    });

    // El diálogo modal ya trae foco atrapado y Escape; se añaden las flechas.
    visor.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(actual - 1);
      else if (e.key === 'ArrowRight') mostrar(actual + 1);
      else return;
      e.preventDefault();
    });

    // Devolver el foco a la miniatura de la imagen que se estaba viendo.
    visor.addEventListener('close', () => miniaturas[actual]?.focus());
  }
</script>

<style>
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .miniatura {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--color-tatami);
    cursor: zoom-in;
    overflow: hidden;
    color: var(--color-luz);
    font: inherit;
    text-align: left;
  }

  .miniatura :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .miniatura:hover :global(img) {
    transform: scale(1.04);
  }

  .pie-miniatura {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 0.75rem 0.5rem;
    background: linear-gradient(transparent, rgb(13 14 16 / 0.9));
    font-size: 0.85rem;
  }

  dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(13 14 16 / 0.96);
    color: var(--color-luz);
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.8);
  }

  .visor-marco {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    padding: 3.5rem 4rem 4rem;
  }

  figure {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    max-height: 100%;
    margin: 0;
  }

  figure :global(img) {
    max-width: 100%;
    max-height: calc(100dvh - 11rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  figcaption {
    min-height: 1.5em;
    text-align: center;
  }

  .contador {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    margin: 0;
    transform: translateX(-50%);
    color: #c4c9cd;
    font-size: 0.85rem;
  }

  .cerrar,
  .nav {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    background: rgb(13 14 16 / 0.85);
    color: var(--color-luz);
    cursor: pointer;
  }

  .cerrar {
    top: 0.75rem;
    right: 0.75rem;
  }

  .nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .anterior {
    left: 0.75rem;
  }

  .siguiente {
    right: 0.75rem;
  }

  .cerrar:hover,
  .nav:hover {
    background: var(--color-acento);
    border-color: var(--color-acento);
  }

  svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 640px) {
    .visor-marco {
      padding: 4rem 0.5rem 4.5rem;
    }

    .nav {
      top: auto;
      bottom: 0.75rem;
      transform: none;
    }

    .anterior {
      left: 1rem;
    }

    .siguiente {
      right: 1rem;
    }
  }
</style>
